{
  "name": "osm-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "sync": "tsx scripts/sync.ts",
    "db:push": "prisma db push --skip-generate",
    "postinstall": "prisma generate",
    "seed:if-empty": "tsx scripts/seed-if-empty.ts",
    "vercel-build": "prisma generate && prisma db push --skip-generate && tsx scripts/seed-if-empty.ts && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "next": "16.4.5",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
